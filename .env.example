# 复制为 .env 后填写。勿提交真实密钥。

# OpenAI 兼容接口
# 示例（百炼 MaaS 专属网关，以控制台「OpenAI 兼容」为准）:
# LLM_BASE_URL=https://xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# true = 不调用模型，返回客户 A 的 Round1 样例（本地演示用）
DRY_RUN=false

# true = 使用开源 LangGraph 多智能体并行生成；false = 单次大模型生成
USE_MULTI_AGENT=true

# 单个智能体超时（秒）与额外重试次数；超时/失败该节点降级占位，整图仍汇合
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIES=1

# 服务端口
HOST=127.0.0.1
PORT=8765
